---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectsHref = `${import.meta.env.BASE_URL}projects/`;
---

<BaseLayout title={`${project.data.title} — кейс`} description={project.data.excerpt}>
  <Header />
  <main class="section">
    <div class="container page">
      <a class="back-link" href={projectsHref}>← Все проекты</a>
      <header class="hero card">
        <p class="meta">{project.data.category}</p>
        <h1>{project.data.title}</h1>
        <p class="lead">{project.data.excerpt}</p>
        <dl class="details">
          <div>
            <dt>Клиент</dt>
            <dd>{project.data.client}</dd>
          </div>
          <div>
            <dt>Год</dt>
            <dd>{project.data.year}</dd>
          </div>
          <div>
            <dt>Услуги</dt>
            <dd>{project.data.services.join(", ")}</dd>
          </div>
        </dl>
      </header>
      <article class="content card">
        <Content />
      </article>
      {
        project.data.galleryImages && project.data.galleryImages.length > 0 && (
          <section class="gallery card" aria-label="Галерея проекта">
            <h2>Визуальные материалы проекта</h2>
            <div
              class={`gallery-grid ${project.data.galleryImages.length === 1 ? "gallery-grid-single" : ""}`}
            >
              {project.data.galleryImages.map((image, index) => (
                <figure class="gallery-item">
                  <img src={image} alt={`${project.data.title}: изображение ${index + 1}`} loading="lazy" />
                </figure>
              ))}
            </div>
          </section>
        )
      }
      {
        project.data.websiteUrl && (
          <section class="live-site card" aria-label="Переход на сайт проекта">
            <h2>Посмотреть реализованный сайт</h2>
            <p>
              Откройте проект в новой вкладке, чтобы увидеть полный пользовательский сценарий и
              финальную реализацию.
            </p>
            <a class="live-site-button" href={project.data.websiteUrl} target="_blank" rel="noreferrer">
              Перейти на сайт проекта
            </a>
          </section>
        )
      }
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 1rem;
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    width: fit-content;
  }

  .hero {
    background:
      radial-gradient(circle at 11% 16%, rgba(242, 111, 174, 0.23), transparent 45%),
      var(--surface);
  }

  .meta {
    margin: 0;
    color: var(--text-muted);
    text-transform: uppercase;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0.5rem 0;
    font-size: clamp(1.9rem, 4vw, 2.8rem);
  }

  .lead {
    margin: 0;
    color: var(--text-muted);
  }

  .details {
    margin: 1.1rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  dt {
    color: var(--text-muted);
    font-size: 0.82rem;
    margin-bottom: 0.22rem;
  }

  dd {
    margin: 0;
  }

  .content :global(h2) {
    margin: 0 0 0.65rem;
    font-size: 1.24rem;
  }

  .content :global(p),
  .content :global(li) {
    color: var(--text-muted);
    line-height: 1.6;
  }

  .gallery {
    background:
      radial-gradient(circle at 14% 12%, rgba(149, 216, 191, 0.14), transparent 42%),
      radial-gradient(circle at 86% 88%, rgba(242, 111, 174, 0.14), transparent 40%),
      var(--surface);
  }

  .gallery h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .gallery-item {
    margin: 0;
    border-radius: 0.9rem;
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }

  .gallery-item:first-child {
    grid-column: span 7;
  }

  .gallery-item:nth-child(2) {
    grid-column: span 5;
  }

  .gallery-item:nth-child(3) {
    grid-column: span 12;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    max-height: 540px;
    object-fit: cover;
    display: block;
  }

  .gallery-grid-single {
    grid-template-columns: minmax(0, 880px);
    justify-content: center;
  }

  .gallery-grid-single .gallery-item {
    grid-column: 1;
  }

  .gallery-grid-single .gallery-item img {
    object-fit: contain;
    max-height: 760px;
    background: rgba(0, 0, 0, 0.18);
  }

  .live-site {
    background:
      radial-gradient(circle at 84% 18%, rgba(242, 111, 174, 0.16), transparent 40%),
      var(--surface);
  }

  .live-site-head {
    margin-bottom: 0.65rem;
  }

  .live-site h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
  }

  .live-site p {
    margin: 0 0 1rem;
    color: var(--text-muted);
  }

  .live-site-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.9rem 1.35rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    color: #1a0d1a;
    background: linear-gradient(120deg, #ff4d9e, #f26fae 55%, #f5b4d4);
    box-shadow:
      0 8px 24px rgba(242, 111, 174, 0.24),
      inset 0 0 0 1px rgba(255, 255, 255, 0.38);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .live-site-button:hover {
    transform: translateY(-1px);
    box-shadow:
      0 12px 26px rgba(242, 111, 174, 0.32),
      inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 760px) {
    .details {
      grid-template-columns: 1fr;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-item:first-child,
    .gallery-item:nth-child(2),
    .gallery-item:nth-child(3) {
      grid-column: span 1;
    }

    .live-site-button {
      width: 100%;
    }
  }
</style>
