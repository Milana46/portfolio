---
const faqs = [
  {
    q: "Сколько времени занимает проект?",
    a: "Сроки зависят от масштаба задачи, но я всегда работаю с четким таймингом и стремлюсь сдавать результат в оговоренный срок, а часто — раньше."
  },
  {
    q: "Помогаете ли вы настроить сайт (хостинг, домен)?",
    a: "Да, сопровождаю запуск под ключ: помогаю с подключением домена и хостинга, настраиваю базовые параметры и показываю, как удобно управлять сайтом дальше."
  },
  {
    q: "Можно ли доработать существующий стиль?",
    a: "Да, можно обновить действующую айдентику без полного редизайна."
  },
  {
    q: "Что входит в итоговую передачу?",
    a: "Финальные файлы для печати и digital-каналов, а также краткий гайд по использованию."
  }
];
---

<section id="faq" class="section">
  <div class="container">
    <h2 class="section-title">Частые вопросы</h2>
    <div class="faq-grid">
      {
        faqs.map((item) => (
          <details class="card">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    margin-top: 1.2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
  }

  details {
    padding: 0.95rem 1rem;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  summary::before {
    content: "▸";
    color: var(--accent);
    font-size: 0.92rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  details[open] summary::before {
    transform: rotate(90deg);
  }

  p {
    margin: 0.8rem 0 0;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
